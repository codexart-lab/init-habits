# Supabase Configuration for init.Habits
# Copy this file to .env and fill in your actual credentials from your Supabase Project Settings > API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Optional: Default Timezone fallback
VITE_DEFAULT_TIMEZONE=UTC
